# LifePolicy AI 환경변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채운다. 실제 값은 절대 커밋하지 않는다.
# 인증키는 Git·채팅·문서가 아닌 팀이 합의한 별도 채널로 공유한다.

# LLM (모델·공급자는 LLM 담당 확정 전, PRD D-06)
OPENAI_API_KEY=

# 온통청년
YOUTH_POLICY_API_KEY=
YOUTH_POLICY_API_URL=https://www.youthcenter.go.kr/go/ythip/getPlcy

# 공공데이터포털 공통 인증키 (행정안전부 및 한국사회보장정보원 공통 참조)
DATA_GO_KR_API_KEY=

# 행정안전부 공공서비스(혜택)
MOIS_BENEFITS_LIST_API_URL=https://api.odcloud.kr/api/gov24/v3/serviceList
MOIS_BENEFITS_DETAIL_API_URL=https://api.odcloud.kr/api/gov24/v3/serviceDetail
MOIS_BENEFITS_CONDITIONS_API_URL=https://api.odcloud.kr/api/gov24/v3/supportConditions

# 한국사회보장정보원 중앙부처복지서비스
WELFARE_LIST_API_URL=https://apis.data.go.kr/B554287/NationalWelfareInformationsV001/NationalWelfarelistV001
WELFARE_DETAIL_API_URL=https://apis.data.go.kr/B554287/NationalWelfareInformationsV001/NationalWelfaredetailedV001

# Neo4j — 로컬 docker-compose 사용 시 URI 형식 예: bolt://localhost:7687
# Neo4j 초기 사용자명은 neo4j 고정, 비밀번호는 8자 이상
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Qdrant — 로컬 docker-compose 사용 시 URL 형식 예: http://localhost:6333
# docker-compose.yml은 이 값을 Qdrant 서버 API 키로도 사용한다
QDRANT_URL=
QDRANT_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434

# 인계 데이터셋 폴더 (선택, 프로젝트 루트 기준 상대 경로 가능). 비우면 data/handoff(v1.3.2)
# Issue #21 최종 후보: data/candidates/issue21-v1.4.0-rag
LIFEPOLICY_DATASET_DIR=
