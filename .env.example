# LifePolicy AI 환경변수 예시
# 이 파일을 .env로 복사한 뒤 값을 채운다. 실제 값은 절대 커밋하지 않는다.
# 인증키는 Git·채팅·문서가 아닌 팀이 합의한 별도 채널로 공유한다.

# LLM (모델·공급자는 LLM 담당 확정 전, PRD D-06)
OPENAI_API_KEY=

# 온통청년 청년정책 Open API (승인 후 발급)
YOUTH_POLICY_API_KEY=

# Neo4j — 로컬 docker-compose 사용 시 URI 형식 예: bolt://localhost:7687
# Neo4j 초기 사용자명은 neo4j 고정, 비밀번호는 8자 이상
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Qdrant — 로컬 docker-compose 사용 시 URL 형식 예: http://localhost:6333
# docker-compose.yml은 이 값을 Qdrant 서버 API 키로도 사용한다
QDRANT_URL=
QDRANT_API_KEY=
