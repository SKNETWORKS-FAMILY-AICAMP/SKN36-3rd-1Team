# web_ssr/.env.example — 값은 web_ssr/.env에 적고 커밋하지 않는다.
# Django는 저장소 루트 .env(OpenAI·DB 키)를 읽지 않는다. 이 폴더의 .env 또는 OS 환경 변수만 읽는다.

# 로컬 개발이면 true(정적 파일 제공·임시 비밀 키 사용). 운영은 false + DJANGO_SECRET_KEY 필수
DJANGO_DEBUG=
DJANGO_SECRET_KEY=
# 쉼표 구분. 기본 127.0.0.1,localhost
DJANGO_ALLOWED_HOSTS=
# HTTPS 배포에서만 true(HTTPS 리다이렉트·HSTS·보안 쿠키). HSTS 기본 3600초
DJANGO_SECURE_HTTPS=
DJANGO_HSTS_SECONDS=

# Django 서버가 호출할 FastAPI 주소(서버→서버). 기본 http://127.0.0.1:8000
SSR_FASTAPI_BASE_URL=
# 브라우저가 돌아갈 React 주소(관계 지도·상담 링크). 기본 http://127.0.0.1:5173/
SSR_REACT_BASE_URL=
# FastAPI 응답 대기(초). 기본 10, 연결 대기 기본 3
SSR_FASTAPI_TIMEOUT_SECONDS=
SSR_FASTAPI_CONNECT_TIMEOUT_SECONDS=
# 정책 목록 메모리 캐시(초). 기본 60, 0이면 캐시 안 함
SSR_CATALOG_CACHE_SECONDS=
